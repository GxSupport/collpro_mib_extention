{
  "manifest_version": 3,
  "name": "MIB Result — проверка задолженности",
  "version": "0.2.0",
  "description": "Собирает данные о задолженности с mib.uz и отправляет в CollPro. Капчу вводит оператор.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://mib.uz/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mib.uz/*"
      ],
      "js": [
        "src/lib/config.js",
        "src/lib/parser.js",
        "src/content/overlay.js",
        "src/content/index.js"
      ],
      "css": [
        "src/content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "MIB Result"
  },
  "options_page": "src/ui/options.html"
}
